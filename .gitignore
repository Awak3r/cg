# Папки сборки CMake
build-*/

# Скомпилированные SPIR-V шейдеры (генерируются из *.vert/.frag)
**/shaders/*.spv

# Раскладка панелей ImGui (перезаписывается при каждом запуске)
imgui.ini

# Промежуточные дампы и прочий временный мусор
*.ppm
*.tmp

# Учебные материалы и зависимости хранятся только локально, в репозиторий не идут
/presentation/
/theory/
/tz/
/deps/
